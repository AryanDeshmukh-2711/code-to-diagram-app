# Same repo-root build context as worker/Dockerfile — see that file's
# comment. Production variant: no [dev] extras. No --reload-equivalent
# concern here, since arq has no dev/prod distinction of its own.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /srv

COPY shared/ /srv/shared/
RUN pip install --no-cache-dir -e /srv/shared

COPY worker/ /srv/worker/
RUN pip install --no-cache-dir -e /srv/worker

WORKDIR /srv/worker

CMD ["arq", "worker.main.WorkerSettings"]
