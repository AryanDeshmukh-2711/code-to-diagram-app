  "flows": [
    {
      "id": "flow-borrow-book",
      "name": "Borrow a book at the lending desk",
      "participants": [
        "member",
        "librarian",
        "book",
        "loan"
      ],
      "steps": [
        {
          "from": "member",
          "message": "requestBook(isbn)",
          "order": 1,
          "to": "librarian"
        },
        {
          "from": "librarian",
          "message": "checkAvailability(isbn)",
          "order": 2,
          "to": "book"
        },
        {
          "from": "book",
          "message": "availableCopies()",
          "order": 3,
          "to": "librarian"
        },
        {
          "from": "librarian",
          "message": "createLoan(memberId, isbn)",
          "order": 4,
          "to": "loan"
        },
        {
          "from": "loan",
          "message": "loanIssued(dueOn)",
          "order": 5,
          "to": "member"
        }
      ]
    },
    {
      "id": "flow-return-book",
      "name": "Return a book and assess any fine",
      "participants": [
        "member",
        "librarian",
        "loan",
        "fine"
      ],
      "steps": [
        {
          "from": "member",
          "message": "returnBook(isbn)",
          "order": 1,
          "to": "librarian"
        },
        {
          "from": "librarian",
          "message": "closeLoan(loanId)",
          "order": 2,
          "to": "loan"
        },
        {
          "from": "loan",
          "message": "assessOverdue(loanId)",
          "order": 3,
          "to": "fine"
        },
        {
          "from": "fine",
          "message": "fineRaised(amount)",
          "order": 4,
          "to": "member"
        }
      ]
    },
    {
      "id": "flow-reserve-book",
      "name": "Place a reservation on an unavailable book",
      "participants": [
        "member",
        "book",
        "reservation"
      ],
      "steps": [
        {
          "from": "member",
          "message": "checkAvailability(isbn)",
          "order": 1,
          "to": "book"
        },
        {
          "from": "book",
          "message": "noCopiesAvailable()",
          "order": 2,
          "to": "member"
        },
        {
          "from": "member",
          "message": "place(memberId, isbn)",
          "order": 3,
          "to": "reservation"
        },
        {
          "from": "reservation",
          "message": "reservationConfirmed(expiresOn)",
          "order": 4,
          "to": "member"
        }
      ]
    }
  ],
  "nodes": [
