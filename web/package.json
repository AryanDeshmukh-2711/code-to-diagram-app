{
  "name": "asa-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run gen:types:check",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest",
    "gen:types": "json2ts -i ../schemas/cpm.schema.json -o src/lib/cpm.generated.ts",
    "gen:types:check": "json2ts -i ../schemas/cpm.schema.json -o /tmp/cpm.generated.ts && diff -u src/lib/cpm.generated.ts /tmp/cpm.generated.ts"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.1.0",
    "json-schema-to-typescript": "^15.0.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
