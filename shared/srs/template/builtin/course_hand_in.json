{
  "id": "course-hand-in",
  "name": "Course hand-in (minimal, US Letter)",
  "description": "No certificate, no logo, dotted contents, document-scoped figure numbering, running header with course code. The opposite pole from the bound report.",
  "origin": "ARCHETYPE — reconstructed from the common North American / European course deliverable format. NOT a template collected from a real department.",
  "page": {
    "width_mm": 215.9,
    "height_mm": 279.4,
    "margin_top_mm": 25.4,
    "margin_bottom_mm": 25.4,
    "margin_inner_mm": 25.4,
    "margin_outer_mm": 25.4,
    "mirror_margins": false
  },
  "styles": {
    "body": {
      "font": "Calibri",
      "size_pt": 11.0,
      "align": "left",
      "line_spacing": 1.15,
      "space_after_pt": 8.0
    },
    "heading1": {
      "font": "Calibri Light",
      "size_pt": 16.0,
      "bold": true,
      "colour": "1F3864",
      "line_spacing": 1.2,
      "space_before_pt": 12.0,
      "space_after_pt": 6.0,
      "keep_with_next": true
    },
    "heading2": {
      "font": "Calibri Light",
      "size_pt": 14.0,
      "bold": true,
      "colour": "1F3864",
      "line_spacing": 1.2,
      "space_before_pt": 10.0,
      "space_after_pt": 6.0,
      "keep_with_next": true
    },
    "heading3": {
      "font": "Calibri Light",
      "size_pt": 12.0,
      "bold": true,
      "colour": "1F3864",
      "line_spacing": 1.2,
      "space_before_pt": 8.0,
      "space_after_pt": 4.0,
      "keep_with_next": true
    },
    "caption": {
      "font": "Calibri",
      "size_pt": 9.0,
      "italic": true,
      "align": "center",
      "colour": "404040",
      "line_spacing": 1.0,
      "space_before_pt": 4.0,
      "space_after_pt": 12.0
    },
    "cover_title": {
      "font": "Calibri Light",
      "size_pt": 26.0,
      "bold": true,
      "colour": "1F3864",
      "align": "left",
      "line_spacing": 1.1,
      "space_after_pt": 12.0
    },
    "cover_field": {
      "font": "Calibri",
      "size_pt": 12.0,
      "align": "left",
      "line_spacing": 1.3,
      "space_after_pt": 2.0
    },
    "index_entry": {
      "font": "Calibri",
      "size_pt": 11.0,
      "line_spacing": 1.2,
      "space_after_pt": 2.0
    }
  },
  "section_numbering": {
    "level_prefixes": ["", "", "", ""],
    "separator": ".",
    "suffix": " ",
    "page_break_before_top_level": false
  },
  "figure_numbering": {
    "scope": "document",
    "label": "Figure",
    "format": "{label} {number}: {caption}",
    "position": "below",
    "style": "caption"
  },
  "table_numbering": {
    "scope": "document",
    "label": "Table",
    "format": "{label} {number}: {caption}",
    "position": "above",
    "style": "caption"
  },
  "front_matter": [
    {
      "kind": "page",
      "id": "cover",
      "blocks": [
        { "kind": "spacer", "height_mm": 45.0 },
        { "kind": "text", "text": "{title}", "style": "cover_title" },
        { "kind": "rule" },
        { "kind": "spacer", "height_mm": 6.0 },
        { "kind": "text", "text": "{course_code} — {institution}", "style": "cover_field" },
        { "kind": "text", "text": "{student_name}", "style": "cover_field" },
        { "kind": "text", "text": "Version {version} · {date}", "style": "cover_field" }
      ]
    },
    {
      "kind": "index",
      "of": "contents",
      "title": "Contents",
      "layout": "dotted",
      "max_depth": 3,
      "page_numbers": true,
      "page_break_after": false
    },
    {
      "kind": "index",
      "of": "figures",
      "title": "List of Figures",
      "layout": "dotted",
      "page_numbers": true,
      "page_break_after": false
    },
    {
      "kind": "index",
      "of": "tables",
      "title": "List of Tables",
      "layout": "dotted",
      "page_numbers": true
    }
  ],
  "running": {
    "header_left": "{course_code}",
    "header_right": "{project}",
    "footer_center": "Page {page} of {pages}",
    "rule_under_header": true,
    "on_front_matter": false
  },
  "fields": [
    { "key": "institution", "label": "Institution", "placeholder": "Example University" },
    { "key": "course_code", "label": "Course code", "placeholder": "SE3040" },
    { "key": "student_name", "label": "Student name" }
  ]
}
