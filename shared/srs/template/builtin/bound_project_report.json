{
  "id": "bound-project-report",
  "name": "Bound project report (Indian university 'black book')",
  "description": "Certificate page, three-column INDEX table, chapter-scoped figure numbering, wide binding margin. The hard case the schema was designed against.",
  "origin": "ARCHETYPE — reconstructed from the common Mumbai/Pune/VTU/Anna project-report format. NOT a template collected from a real department; replace with the genuine one before shipping.",
  "page": {
    "width_mm": 210.0,
    "height_mm": 297.0,
    "margin_top_mm": 25.4,
    "margin_bottom_mm": 25.4,
    "margin_inner_mm": 38.1,
    "margin_outer_mm": 25.4,
    "mirror_margins": true
  },
  "styles": {
    "body": {
      "font": "Times New Roman",
      "size_pt": 12.0,
      "align": "justify",
      "line_spacing": 1.5,
      "space_after_pt": 6.0
    },
    "heading1": {
      "font": "Times New Roman",
      "size_pt": 16.0,
      "bold": true,
      "all_caps": true,
      "align": "center",
      "line_spacing": 1.5,
      "space_before_pt": 0.0,
      "space_after_pt": 18.0,
      "keep_with_next": true
    },
    "heading2": {
      "font": "Times New Roman",
      "size_pt": 14.0,
      "bold": true,
      "line_spacing": 1.5,
      "space_before_pt": 12.0,
      "space_after_pt": 6.0,
      "keep_with_next": true
    },
    "heading3": {
      "font": "Times New Roman",
      "size_pt": 12.0,
      "bold": true,
      "line_spacing": 1.5,
      "space_before_pt": 10.0,
      "space_after_pt": 4.0,
      "keep_with_next": true
    },
    "caption": {
      "font": "Times New Roman",
      "size_pt": 11.0,
      "bold": true,
      "align": "center",
      "line_spacing": 1.0,
      "space_before_pt": 4.0,
      "space_after_pt": 14.0
    },
    "cover_title": {
      "font": "Times New Roman",
      "size_pt": 20.0,
      "bold": true,
      "all_caps": true,
      "align": "center",
      "line_spacing": 1.2,
      "space_after_pt": 10.0
    },
    "cover_institution": {
      "font": "Times New Roman",
      "size_pt": 18.0,
      "bold": true,
      "all_caps": true,
      "align": "center",
      "line_spacing": 1.2,
      "space_after_pt": 4.0
    },
    "cover_field": {
      "font": "Times New Roman",
      "size_pt": 14.0,
      "align": "center",
      "line_spacing": 1.3,
      "space_after_pt": 4.0
    },
    "cover_label": {
      "font": "Times New Roman",
      "size_pt": 13.0,
      "italic": true,
      "align": "center",
      "line_spacing": 1.2,
      "space_after_pt": 2.0
    },
    "certificate_body": {
      "font": "Times New Roman",
      "size_pt": 13.0,
      "align": "justify",
      "line_spacing": 2.0,
      "space_after_pt": 14.0
    },
    "signature": {
      "font": "Times New Roman",
      "size_pt": 12.0,
      "align": "center",
      "line_spacing": 1.0,
      "space_after_pt": 0.0
    },
    "index_entry": {
      "font": "Times New Roman",
      "size_pt": 12.0,
      "line_spacing": 1.5,
      "space_after_pt": 0.0
    }
  },
  "section_numbering": {
    "level_prefixes": ["Chapter ", "", "", ""],
    "separator": ".",
    "suffix": " ",
    "page_break_before_top_level": true
  },
  "figure_numbering": {
    "scope": "chapter",
    "label": "Fig.",
    "format": "{label} {number} {caption}",
    "position": "below",
    "style": "caption"
  },
  "table_numbering": {
    "scope": "chapter",
    "label": "Table",
    "format": "{label} {number} {caption}",
    "position": "above",
    "style": "caption"
  },
  "front_matter": [
    {
      "kind": "page",
      "id": "cover",
      "blocks": [
        { "kind": "image", "field": "logo", "align": "center", "max_height_mm": 28.0, "max_width_mm": 28.0 },
        { "kind": "text", "text": "{institution}", "style": "cover_institution" },
        { "kind": "text", "text": "{department}", "style": "cover_field" },
        { "kind": "spacer", "height_mm": 14.0 },
        { "kind": "text", "text": "A PROJECT REPORT ON", "style": "cover_label" },
        { "kind": "text", "text": "{title}", "style": "cover_title" },
        { "kind": "spacer", "height_mm": 10.0 },
        { "kind": "text", "text": "Submitted in partial fulfilment of the requirements for {course_code}", "style": "cover_label" },
        { "kind": "spacer", "height_mm": 8.0 },
        { "kind": "text", "text": "Submitted by", "style": "cover_label" },
        { "kind": "text", "text": "{student_name}", "style": "cover_field" },
        { "kind": "text", "text": "Enrolment No. {enrolment_number}", "style": "cover_field" },
        { "kind": "spacer", "height_mm": 8.0 },
        { "kind": "text", "text": "Under the guidance of", "style": "cover_label" },
        { "kind": "text", "text": "{guide_name}", "style": "cover_field" },
        { "kind": "spacer", "height_mm": 12.0 },
        { "kind": "text", "text": "{academic_year}", "style": "cover_field" }
      ]
    },
    {
      "kind": "page",
      "id": "certificate",
      "title": "CERTIFICATE",
      "blocks": [
        { "kind": "text", "text": "{institution}", "style": "cover_institution" },
        { "kind": "text", "text": "{department}", "style": "cover_field" },
        { "kind": "spacer", "height_mm": 12.0 },
        { "kind": "text", "text": "CERTIFICATE", "style": "cover_title" },
        { "kind": "rule" },
        { "kind": "spacer", "height_mm": 8.0 },
        {
          "kind": "text",
          "text": "This is to certify that {student_name}, bearing enrolment number {enrolment_number}, has satisfactorily completed the project work entitled \"{title}\" in partial fulfilment of the requirements of {course_code} in the {department} of {institution} during the academic year {academic_year}. The work has been carried out under my supervision and has not been submitted elsewhere for the award of any other degree.",
          "style": "certificate_body"
        },
        { "kind": "spacer", "height_mm": 24.0 },
        { "kind": "signatures", "roles": ["Project Guide", "Head of Department", "External Examiner"], "style": "signature" }
      ]
    },
    {
      "kind": "index",
      "of": "contents",
      "title": "INDEX",
      "layout": "table",
      "columns": ["Sr. No.", "Chapter / Section", "Page No."],
      "max_depth": 2,
      "page_numbers": true
    },
    {
      "kind": "index",
      "of": "figures",
      "title": "LIST OF FIGURES",
      "layout": "table",
      "columns": ["Fig. No.", "Title", "Page No."],
      "page_numbers": true
    }
  ],
  "running": {
    "footer_center": "{page}",
    "rule_under_header": false,
    "on_front_matter": false
  },
  "fields": [
    { "key": "institution", "label": "Institution", "placeholder": "University of Mumbai" },
    { "key": "department", "label": "Department", "placeholder": "Department of Computer Engineering" },
    { "key": "course_code", "label": "Course code", "placeholder": "CSC802" },
    { "key": "student_name", "label": "Student name" },
    { "key": "enrolment_number", "label": "Enrolment number" },
    { "key": "guide_name", "label": "Project guide" },
    { "key": "academic_year", "label": "Academic year", "kind": "year", "placeholder": "2025-26" },
    { "key": "logo", "label": "Institution logo", "kind": "image", "required": false, "help": "PNG or JPEG. Placed at the top of the cover page." }
  ]
}
