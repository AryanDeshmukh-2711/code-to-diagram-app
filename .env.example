# Copy to .env and fill in. Compose supplies local-dev defaults for everything
# except the secrets at the bottom, so an empty .env is enough to boot the stack.

# --- Application ---------------------------------------------------------
APP_ENV=
LOG_LEVEL=
API_PORT=
WEB_PORT=

# --- PostgreSQL ----------------------------------------------------------
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
DATABASE_URL=

# --- Redis ---------------------------------------------------------------
REDIS_PORT=
REDIS_URL=

# --- PlantUML (hard dependency — see CLAUDE.md diagram engine rule) ------
PLANTUML_PORT=
PLANTUML_SERVER_URL=

# --- Object storage (S3-compatible / Cloudflare R2) ----------------------
S3_ENDPOINT_URL=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- LLM Gateway ---------------------------------------------------------
# Read ONLY by the LLM Gateway module. No other module may reference these.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=

# --- Web -----------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=

# --- Security ------------------------------------------------------------
SECRET_KEY=
