# Copy to .env and fill in. Compose supplies local-dev defaults for everything
# except the secrets at the bottom, so an empty .env is enough to boot the stack.

# --- Application ---------------------------------------------------------
APP_ENV=
LOG_LEVEL=
API_PORT=
WEB_PORT=

# --- PostgreSQL ----------------------------------------------------------
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
DATABASE_URL=

# --- Redis ---------------------------------------------------------------
REDIS_PORT=
REDIS_URL=

# --- PlantUML (hard dependency — see CLAUDE.md diagram engine rule) ------
PLANTUML_PORT=
PLANTUML_SERVER_URL=

# --- Object storage (S3-compatible / Cloudflare R2) ----------------------
S3_ENDPOINT_URL=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- LLM Gateway ---------------------------------------------------------
# Read ONLY by the LLM Gateway module. No other module may reference these.
#
# Defaults are local inference via Ollama on the host: free, no key, no quota,
# and nothing leaves the machine — which is what makes "user content is not
# used for training" (SRS 6.3, 9.2) true rather than merely promised. Most free
# hosted tiers train on submitted content by default.
#
#   LLM_PROVIDER          ollama | openai_compatible
#   LLM_BASE_URL          Ollama endpoint (host, not container — it needs the GPU)
#   LLM_MODEL             overrides the default model in shared/llm/config.py
#   LLM_OPENAI_BASE_URL   set to use any OpenAI-compatible endpoint instead
#                         (Groq, OpenRouter, Together, LM Studio, vLLM)
#   LLM_API_KEY           bearer token for the above; blank for local servers
LLM_PROVIDER=
LLM_BASE_URL=
LLM_MODEL=
LLM_OPENAI_BASE_URL=
LLM_API_KEY=

# --- Web -----------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=

# --- Security ------------------------------------------------------------
SECRET_KEY=

# Signs artefact and export download links (NFR-S4).
# The API refuses to sign anything without it rather than falling back to a
# default, because a committed default is forgeable by anyone who reads the
# source. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ASA_SIGNING_SECRET=
